{
  "name": "moneybee-open-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MoneyBee Open API: spec-first foundation, sandbox server and module pattern",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spec:bundle": "tsx scripts/bundle.ts",
    "lint:spec": "tsx scripts/bundle.ts && spectral lint dist/openapi.bundled.yaml --ruleset .spectral.yaml --fail-severity=warn",
    "spec:baseline": "tsx scripts/bundle.ts && tsx scripts/breaking.ts --write-baseline",
    "spec:breaking": "tsx scripts/bundle.ts && tsx scripts/breaking.ts",
    "new:module": "tsx scripts/new-module.ts",
    "ci": "npm run typecheck && npm run lint:spec && npm run spec:breaking && npm test"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.14.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
