# MoneyBee Onboard - environment. Copy to .env (or run `npm run setup` to generate secrets).

# --- AI (leave ANTHROPIC_API_KEY empty to run with the MOCK fixture parser) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_HEAVY=claude-opus-5-5
# auto = live when a key is set, mock otherwise | live | mock
LLM_MODE=auto
CASE_TOKEN_BUDGET=400000

# --- Data stores (values for `npm run dev` on the host; docker compose sets its own) ---
MONGO_URL=mongodb://localhost:27017/moneybee_onboard
# System of record: mongo (default) | mssql (optional, docker compose --profile mssql) | memory (tests)
REPO=mongo
MSSQL_URL=Server=localhost,1433;Database=moneybee_onboard;User Id=sa;Password=MoneyBee_Dev_123!;Encrypt=false;TrustServerCertificate=true
MSSQL_SA_PASSWORD=MoneyBee_Dev_123!
REDIS_URL=redis://localhost:6379
STORAGE=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=moneybee-onboard
S3_ACCESS_KEY=moneybee
S3_SECRET_KEY=moneybee-dev-secret
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=moneybee
MINIO_ROOT_PASSWORD=moneybee-dev-secret

# --- Secrets (32 random bytes, base64). Never commit real values. ---
PII_ENC_KEY=
PII_ENC_KEY_ID=k1
JWT_SECRET=
COOKIE_SECURE=false

# --- Tokens and webhook ---
TOKEN_TTL_HOURS=24
ONBOARDING_WEBHOOK_URL=
ONBOARDING_WEBHOOK_SECRET=
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Screening: mock only for now (see docs/MOCKS.md) ---
SCREENING_PROVIDER=mock
# Self-hosted sanctions screening (docker service watchman); wired in through the Risk API in phase 3
WATCHMAN_URL=http://localhost:8084
WATCHMAN_LISTS=us_ofac

# --- Tenants (white-label). Files in tenants/*.json are loaded on first boot; edit afterwards in Settings. ---
# TENANTS_DIR=./tenants

# --- Outbound email (magic links). Docker uses Mailpit: open http://localhost:8025 to read the mails. ---
SMTP_URL=smtp://localhost:1025
# Docker uses smtp://mailpit:1025 automatically; set DOCKER_SMTP_URL to send real email from the containers
# DOCKER_SMTP_URL=
# Docker builds portal links from WEB_PORT (http://localhost:<WEB_PORT>); set DOCKER_PUBLIC_WEB_URL for a real domain
# DOCKER_PUBLIC_WEB_URL=
MAIL_FROM=MoneyBee Onboard <no-reply@moneybee.local>
# MAILER=smtp|log|memory (default: smtp when SMTP_URL is set, otherwise log)

# --- Merchant self-serve portal (/apply) ---
PORTAL_LINK_TTL_HOURS=72
PORTAL_SESSION_HOURS=12
PORTAL_MAX_FILES=60

# --- Users ---
ADMIN_EMAIL=admin@moneybee.local
ADMIN_PASSWORD=
SEED_DEMO_DATA=true
DEMO_PASSWORD=

# --- Optional mail intake (IMAP / Gmail API adapter; not required) ---
MAIL_HOST=
MAIL_USER=
MAIL_PASS=

# --- UAE PASS (see README section "UAE PASS") ---
# mock = built-in simulator, no credentials. live = real UAE PASS (needs onboarding with the UAE PASS team).
UAEPASS_MODE=mock
# Feature flag for signing the merchant agreement with UAE PASS
UAEPASS_SIGNING_ENABLED=false
UAEPASS_PROVIDER_NAME=MoneyBee
UAEPASS_SHARE_TTL_MINUTES=30
UAEPASS_INVITE_TTL_HOURS=72
PUBLIC_WEB_URL=http://localhost:5173
# Live only. Endpoint defaults are UNVERIFIED staging values: confirm during onboarding.
UAEPASS_BASE_URL=https://stg-id.uaepass.ae
UAEPASS_CLIENT_ID=
UAEPASS_CLIENT_SECRET=
UAEPASS_REDIRECT_URI=
