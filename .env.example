# Copy to .env. Never commit real values. In live, these come from a secrets manager.

# Required. At least 32 characters. Signs access tokens and pagination cursors.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MB_SIGNING_SECRET=

# sandbox is the only environment this phase serves.
MB_ENV=sandbox
PORT=8080

# Placeholder docs host used in error doc_url values. Replace when docs are published.
MB_DOCS_BASE_URL=https://docs.moneybee.example

# Sandbox defaults (targets, not commitments for live)
MB_RATE_LIMIT_PER_MIN=120
MB_TOKEN_TTL_SECONDS=3600
MB_IDEMPOTENCY_WINDOW_HOURS=24

# Webhook delivery. Sandbox only: allow http://localhost receivers.
MB_ALLOW_HTTP_LOOPBACK_WEBHOOKS=true
